# LLM Configuration
# Primary: Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: DeepSeek API (Alternative LLM engine)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Provider Selection: "gemini" (default) or "deepseek"
LLM_PROVIDER=gemini

# Notion Database Integration
NOTION_TOKEN=ntn_your_notion_integration_token_here
NOTION_DATABASE_ID=your_32_character_notion_database_id_here

# Telegram Alert Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_or_channel_id_here

# Evaluation Thresholds
FIT_SCORE_THRESHOLD=75
